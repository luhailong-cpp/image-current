  "positionPairs": [
    {
      "frames": [
        1,
        2
      ],
      "position": "P1",
      "supportLeg": "left",
      "observations": "左脚在髋前伸出，鞋尖沿右下方向，后腿屈曲回收；前靴跟部先承接。 左支撑鞋掌放平、膝角加深，脚相对髋的位置比01更近，右腿仍后收。"
    },
    {
      "frames": [
        3,
        4
      ],
      "position": "P2",
      "supportLeg": "left",
      "observations": "左支撑靴到髋下，胫骨较直，右膝折起；鞋轴没有横向翻转。 同一髋下支撑腿保持，另一靴开始由后向前通过；支撑膝比03略压低。"
    },
    {
      "frames": [
        5,
        6
      ],
      "position": "P3",
      "supportLeg": "left",
      "observations": "左承重腿后移到髋后偏左位置，前摆右靴露底悬起，双腿前后分开。 左承重踝继续后伸，右膝向右下前送、露底面积增加；后侧靴掌持续着地。"
    },
    {
      "frames": [
        7,
        8
      ],
      "position": "P4",
      "supportLeg": "left",
      "observations": "已修复：右摆动小腿继续向右下前送，位于06与08之间；保留自然轻微膝屈与踝背屈，左后前掌支撑位置保留，消除缩回膝后的回跳。 左后掌继续压地且脚跟抬高，右摆腿膝角打开向前下送，前靴与后支撑明显分离。",
      "videoAxisRepairObservation": "已修复：右摆动小腿继续向右下前送，位于06与08之间；保留自然轻微膝屈与踝背屈，左后前掌支撑位置保留，消除缩回膝后的回跳。"
    },
    {
      "frames": [
        9,
        10
      ],
      "position": "P1",
      "supportLeg": "right",
      "observations": "换右腿前落；支撑腿从另一髋链向前送，前靴沿右下伸出，左腿折回。 右脚掌变平并缓冲，另一腿继续折回，支撑膝比09弯曲。"
    },
    {
      "frames": [
        11,
        12
      ],
      "position": "P2",
      "supportLeg": "right",
      "observations": "右支撑靴经过髋下，左膝从前方交叠提起；靴轴仍顺前进方向。 右支撑继续在髋下，左摆动靴从后向前收过，双靴分开；与11膝踝角有区别。"
    },
    {
      "frames": [
        13,
        14
      ],
      "position": "P3",
      "supportLeg": "right",
      "observations": "右支撑靴移到稍后方，左腿前送、鞋底朝前可见，后腿的踝部仍承接。 已修复：左摆动小腿处于13到15的前送展开中间姿态，右支撑足仍在髋后P3承重，未再折回膝下。",
      "videoAxisRepairObservation": "已修复：左摆动小腿处于13到15的前送展开中间姿态，右支撑足仍在髋后P3承重，未再折回膝下。"
    },
    {
      "frames": [
        15,
        16
      ],
      "position": "P4",
      "supportLeg": "right",
      "observations": "右腿再后伸进入前掌蹬地，后鞋跟抬高，左腿在前露底悬起。 右后前掌保留接触且脚跟进一步提高，左小腿向右下前送准备换脚，接01前落。"
    }
  ],
